PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin Service Account Key (Absolute path to local JSON key file)
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Supabase Private Storage Configuration (Free Plan - Private Bucket: 'resumes')
# Retrieve from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
# IMPORTANT: Keep strictly on backend. Never expose to client or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=resumes
